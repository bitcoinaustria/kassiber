    "replace": "while unused <= gap {",
    "expect_failing": [
      "gap_resets_at_used_addresses_and_scans_branches_independently"
    ],
    "rule": "Stop at a complete consecutive unused gap."
  },
  {
    "id": "discovery-gap-reset",
    "file": "crates/wallets/src/scan.rs",
