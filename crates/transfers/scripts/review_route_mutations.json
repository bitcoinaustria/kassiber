[
  {"id": "RVR-daemon-unknown-fields", "file": "crates/daemon/src/review.rs",
   "find": "        return Err(AppError::new(\"validation\", \"Unsupported review arguments\"));",
   "replace": "        let _ = \"Unsupported review arguments\";",
   "expect_failing": ["desktop_review_arguments_refuse_in_python_order_and_author_gui"],
   "rule": "Desktop review requests refuse fields outside each kind's Python allowlist."},
  {"id": "RVR-daemon-required-fields", "file": "crates/daemon/src/review.rs",
   "find": "        .any(|field| !entries.iter().any(|(key, _)| named(key, field)))",
   "replace": "        .any(|field| field.is_empty() && !entries.iter().any(|(key, _)| named(key, field)))",
   "expect_failing": ["desktop_review_arguments_refuse_in_python_order_and_author_gui"],
   "rule": "Desktop review requests refuse missing required fields before any book access."},
  {"id": "RVR-daemon-author", "file": "crates/daemon/src/review.rs",
   "find": "    book.review(&operation, args, \"gui\")",
   "replace": "    book.review(&operation, args, \"user\")",
   "expect_failing": ["desktop_review_arguments_refuse_in_python_order_and_author_gui"],
   "rule": "Desktop applications are authored gui, as Python's daemon records them."},
  {"id": "RVR-daemon-apply-registered", "file": "crates/daemon/src/review.rs",
   "find": "    \"ui.review.apply\",\n    \"ui.review.receipt\",\n];",
   "replace": "    \"ui.review.receipt\",\n];",
   "expect_failing": ["desktop_review_arguments_refuse_in_python_order_and_author_gui"],
   "rule": "All five review kinds are served natively, in Python's advertised order."},
  {"id": "RVR-cli-author", "file": "crates/cli/src/review.rs",
   "find": "    book.review(operation, &payload, \"cli\")",
   "replace": "    book.review(operation, &payload, \"gui\")",
   "expect_failing": ["review_cli_reads_bounded_files_unwraps_envelopes_and_authors_cli"],
   "rule": "CLI applications are authored cli."},
  {"id": "RVR-cli-scope-first", "file": "crates/cli/src/review.rs",
   "find": "    book.resolve_scope(Some(&workspace), Some(&profile))?;",
   "replace": "",
   "expect_failing": ["review_cli_resolves_scope_before_reading_any_file"],
   "rule": "The book scope resolves before any review input file is read."},
  {"id": "RVR-cli-size-bound", "file": "crates/cli/src/review.rs",
   "find": "    if payload.len() as u64 > MAX_REVIEW_FILE_BYTES {",
   "replace": "    if payload.len() as u64 >= MAX_REVIEW_FILE_BYTES {",
   "expect_failing": ["review_cli_reads_bounded_files_unwraps_envelopes_and_authors_cli"],
   "rule": "Review input files of exactly one million bytes are admitted; one more byte is refused."},
  {"id": "RVR-cli-desktop-envelope", "file": "crates/cli/src/review.rs",
   "find": " || *kind == s(\"ui.review.plan\")",
   "replace": "",
   "expect_failing": ["review_cli_reads_bounded_files_unwraps_envelopes_and_authors_cli"],
   "rule": "Apply accepts the artifact inside a CLI or desktop plan envelope."},
  {"id": "RVR-cli-operations-object", "file": "crates/cli/src/review.rs",
   "find": "            if matches!(operations, Value::Dict(_)) {",
   "replace": "            if matches!(operations, Value::Null) {",
   "expect_failing": ["review_cli_reads_bounded_files_unwraps_envelopes_and_authors_cli"],
   "rule": "A plan file may hold an operations array or an object naming one."},
  {"id": "RVR-input-version", "file": "crates/journals/src/review_workflow.rs",
   "find": "    review_support::require_input_version(conn, scope, &expected)?;",
   "replace": "",
   "expect_failing": ["review_input_requests_match_python_packets_digests_and_refusals_without_writes",
                      "review_input_requests_keep_a_caller_transaction_open_and_see_its_edits"],
   "rule": "An input request binds the book's exact current input version."},
  {"id": "RVR-input-current-case", "file": "crates/journals/src/review_workflow.rs",
   "find": "(row, reasons.get(&transaction_id))",
   "replace": "(row, reasons.get(&transaction_id).or(reasons.values().next()))",
   "expect_failing": ["review_input_requests_match_python_packets_digests_and_refusals_without_writes"],
   "rule": "Only a current canonical case can be named in an input request."},
  {"id": "RVR-input-attach-one", "file": "crates/journals/src/review_workflow.rs",
   "find": "    if action == s(\"attach_evidence\") && ids.len() != 1 {",
   "replace": "    if action == s(\"attach_evidence\") && ids.len() > 20 {",
   "expect_failing": ["review_input_requests_match_python_packets_digests_and_refusals_without_writes"],
   "rule": "Evidence attaches to exactly one case."},
  {"id": "RVR-input-control-text", "file": "crates/journals/src/review_workflow.rs",
   "find": ".any(|point| point < 32 && point != 10 && point != 9) =>",
   "replace": ".any(|point| point < 9) =>",
   "expect_failing": ["review_input_requests_match_python_packets_digests_and_refusals_without_writes"],
   "rule": "Explanations are plain text: control characters other than tab and newline refuse."},
  {"id": "RVR-input-distinct", "file": "crates/journals/src/review_workflow.rs",
   "find": "        || distinct.len() != ids.len()",
   "replace": "",
   "expect_failing": ["review_input_requests_match_python_packets_digests_and_refusals_without_writes"],
   "rule": "Case identifiers in one request are distinct."},
  {"id": "RVR-input-sorted", "file": "crates/journals/src/review_workflow.rs",
   "find": "    sorted.sort();",
   "replace": "",
   "expect_failing": ["review_input_requests_match_python_packets_digests_and_refusals_without_writes"],
   "rule": "Packets list cases in sorted order, so their digest ignores request order."},
  {"id": "RVR-input-digest-content", "file": "crates/journals/src/review_workflow.rs",
   "find": "        (\"explanation\", explanation),\n    ]);",
   "replace": "    ]);",
   "expect_failing": ["review_input_requests_match_python_packets_digests_and_refusals_without_writes"],
   "rule": "The request digest covers the whole packet, including the explanation."},
  {"id": "RVR-execute-commit", "file": "crates/journals/src/review_workflow.rs",
   "find": "                commit: true,",
   "replace": "                commit: false,",
   "expect_failing": ["review_execute_routes_plans_commits_applies_and_reads_receipts_as_authored"],
   "rule": "A product application commits at the service boundary."},
  {"id": "RVR-execute-author", "file": "crates/journals/src/review_workflow.rs",
   "find": "                authored_source,\n                commit: true,",
   "replace": "                authored_source: \"user\",\n                commit: true,",
   "expect_failing": ["review_execute_routes_plans_commits_applies_and_reads_receipts_as_authored"],
   "rule": "The caller's authored source reaches the receipt and history writers."},
  {"id": "RVR-receipt-transport-order", "file": "crates/journals/src/review_apply.rs",
   "find": "            (\"operations\", results),\n            (\"transaction_ids\", affected),",
   "replace": "            (\"transaction_ids\", affected),\n            (\"operations\", results),",
   "expect_failing": ["review_apply_receipts_keep_python_transport_key_order"],
   "rule": "Receipts keep Python's transport key order: operations before affected anchors."}
]
