    "find": ".replace('(', \"\\\\(\")",
    "replace": "",
    "expect_failing": [
      "documents_match_python_bytes_and_pages"
    ],
    "rule": "PDF string literals escape parentheses."
  },
  {
    "id": "text-page-capacity",
    "file": "crates/pdf/src/text.rs",
    "find": "let mut pages: Vec<&[String]> = wrapped.chunks(LINES_PER_PAGE).collect();",
    "replace": "let mut pages: Vec<&[String]> = wrapped.chunks(LINES_PER_PAGE + 1).collect();",
    "expect_failing": [
      "documents_match_python_bytes_and_pages"
    ],
    "rule": "A page holds exactly 46 wrapped lines."
  },
  {
