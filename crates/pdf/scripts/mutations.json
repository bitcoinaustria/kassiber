[
  {
    "id": "text-wrap-fit",
    "file": "crates/pdf/src/text.rs",
    "find": "if line.len() + chunk.len() > width {",
    "replace": "if line.len() + chunk.len() > width + 1 {",
    "expect_failing": [
      "wrapping_matches_python_textwrap"
    ],
    "rule": "A chunk fits only when the line stays within the width, as in textwrap."
  },
  {
    "id": "text-wrap-long-word",
    "file": "crates/pdf/src/text.rs",
    "find": "let end = width - line.len();",
    "replace": "let end = width;",
    "expect_failing": [
      "wrapping_matches_python_textwrap"
    ],
    "rule": "A word longer than a line is split at the space left on the current line."
  },
  {
    "id": "text-expand-tabs",
    "file": "crates/pdf/src/text.rs",
    "find": "let spaces = 8 - column % 8;",
    "replace": "let spaces = 8;",
    "expect_failing": [
      "wrapping_matches_python_textwrap"
    ],
    "rule": "Tabs expand to the next multiple of eight columns before wrapping."
  },
  {
    "id": "text-transliteration",
    "file": "crates/pdf/src/text.rs",
    "find": "'€' => \"EUR\",",
    "replace": "'€' => \"E\",",
    "expect_failing": [
      "wrapping_matches_python_textwrap",
      "documents_match_python_bytes_and_pages"
    ],
    "rule": "Characters outside Latin-1 are transliterated with Python's table before replacement."
  },
  {
    "id": "text-table-rstrip",
