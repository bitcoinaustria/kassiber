    "replace": "        Platform::Macos => \"\",",
    "expect_failing": [
      "macos_connections_set_both_fullfsync_pragmas"
    ],
    "rule": "Every Rust book connection on macOS sets fullfsync and checkpoint_fullfsync."
  },
  {
