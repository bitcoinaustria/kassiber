[
  {
    "id": "json-frame-receive-limit",
    "file": "crates/operator/src/protocol.rs",
    "find": "    if size > limit {",
    "replace": "    if size >= limit {",
    "expect_failing": [
      "frame_limits_hold_at_their_boundaries"
    ],
    "rule": "A frame of exactly the limit is read; one byte more is refused before its body."
  },
