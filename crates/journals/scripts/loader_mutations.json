  {
    "id": "JL-blob-refusal",
    "file": "crates/journals/src/loader.rs",
    "find": "ValueRef::Blob(_) => {\n            return Err(Error::Unsupported(\n                \"custody snapshot v1 cannot serialize SQLite BLOB\",\n            ))\n        }",
    "replace": "ValueRef::Blob(_) => Value::Null,",
    "expect_failing": [
      "native_loader_keeps_sql_values_and_refuses_blob_coercion"
    ],
    "rule": "A legacy blob is never coerced to a null fact."
