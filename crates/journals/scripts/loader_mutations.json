[
  {
    "id": "JL-write-lock",
    "file": "crates/journals/src/loader.rs",
    "find": "conn.transaction_state(Some(\"main\"))? != rusqlite::TransactionState::Write",
    "replace": "conn.transaction_state(Some(\"main\"))? == rusqlite::TransactionState::Write",
    "expect_failing": [
      "native_loader_requires_caller_write_transaction"
    ],
    "rule": "write lock"
  },
  {
    "id": "JL-integer-storage",
