        {
          "key": "quantity_check",
          "label": "Quantity Check",
          "format": "quantity",
          "formula": "=ROUND({opening_quantity}+{acquired_quantity}-{disposed_quantity}-{fee_quantity}+{transfer_net}-{closing_quantity},{decimals})"
        },
