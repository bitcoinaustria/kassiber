        {
          "key": "basis_check",
          "label": "Basis Check ({fiat})",
          "format": "money",
          "formula": "=ROUND({opening_cost_basis}+{acquired_value}-{disposed_cost_basis}-{fee_cost_basis}+{transfer_basis_net}-{closing_cost_basis},2)"
