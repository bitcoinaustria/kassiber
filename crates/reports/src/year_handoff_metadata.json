        {
          "key": "inflow",
          "label": "Received",
          "format": "quantity",
          "formula": null
        },
        {
          "key": "outflow",
          "label": "Sent",
          "format": "quantity",
          "formula": null
        },
        {
          "key": "fee",
          "label": "Fees",
          "format": "quantity",
          "formula": null
        },
        {
          "key": "closing_observed",
          "label": "Closing (observed)",
          "format": "quantity",
          "formula": "=ROUND({opening_observed}+{inflow}-{outflow}-{fee},{decimals})"
        },
        {
          "key": "closing_journal",
          "label": "Closing (journal)",
          "format": "quantity",
          "formula": null
        },
        {
          "key": "opening_difference",
          "label": "Opening Difference",
          "format": "quantity",
          "formula": "=ROUND({opening_journal}-{opening_observed},{decimals})"
        },
        {
          "key": "closing_difference",
          "label": "Closing Difference",
          "format": "quantity",
          "formula": "=ROUND({closing_journal}-{closing_observed},{decimals})"
        },
        {
          "key": "status",
          "label": "Status",
          "format": "text",
          "formula": "=IF(AND({opening_difference}=0,{closing_difference}=0),\"OK\",\"DIFF\")"
        },
        {
          "key": "opening_difference_exact",
          "label": "Opening Difference (exact)",
          "format": "text",
          "formula": null
        },
        {
