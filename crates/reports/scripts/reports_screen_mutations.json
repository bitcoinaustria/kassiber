    "id": "kz-boundary-instant",
    "file": "crates/reports/src/calendar.rs",
    "find": "time::parse(\"2022-02-28T23:00:00Z\")",
    "replace": "time::parse(\"2022-03-01T00:00:00Z\")",
    "expect_failing": [
      "calendar::tests::vienna_calendar_vectors",
      "austrian_vectors"
    ],
    "rule": "The crypto Kennzahlen start at 00:00 on 1 March 2022 in Vienna (CET), 23:00 UTC the day before."
  },
