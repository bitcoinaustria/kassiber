    "replace": "if let Some(Value::List(allowed)) = get(schema, \"enum\").filter(|_| expected.is_empty()) {",
    "expect_failing": [
      "synthetic_validation_matches_python",
      "catalog_validation_matches_python"
    ],
    "rule": "An enum is enforced alongside a declared type."
  },
  {
