[
  {
    "id": "A-validate-required-before-unknown",
    "file": "crates/ai/src/validate.rs",
    "find": "        if !missing.is_empty() {",
    "replace": "        if !missing.is_empty() && pairs.iter().all(|(key, _)| property(properties, key).is_some()) {",
    "expect_failing": [
      "synthetic_validation_matches_python",
      "catalog_validation_matches_python"
    ],
    "rule": "Missing required fields are reported before unsupported ones."
  },
  {
    "id": "A-validate-enum",
