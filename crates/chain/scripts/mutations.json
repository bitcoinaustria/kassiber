[
  {
    "id": "electrum-wire-version",
    "file": "crates/chain/src/electrum.rs",
    "find": "\"jsonrpc\":\"2.0\"",
    "replace": "\"jsonrpc\":\"1.0\"",
    "expect_failing": [
      "electrum_batches_reorder_ignore_notifications_and_split_at_configured_size"
    ],
    "rule": "Electrum requests use JSON-RPC 2.0."
  },
  {
    "id": "electrum-batch-size",
    "file": "crates/chain/src/electrum.rs",
    "find": "requests.chunks(self.backend.batch_size)",
    "replace": "requests.chunks(1)",
    "expect_failing": [
      "electrum_batches_reorder_ignore_notifications_and_split_at_configured_size"
    ],
    "rule": "The configured batch size controls newline request groups."
  },
  {
    "id": "electrum-order",
    "file": "crates/chain/src/electrum.rs",
    "find": "results[index] = message.get(\"result\")",
    "replace": "results[requests.len() - 1 - index] = message.get(\"result\")",
    "expect_failing": [
      "electrum_batches_reorder_ignore_notifications_and_split_at_configured_size"
    ],
    "rule": "Out-of-order replies must return in request order."
  },
  {
