[
  {
    "id": "S-input-nul",
    "file": "crates/secrets/src/lib.rs",
    "find": "if value.is_empty() || value.contains('\\0') {",
    "replace": "if value.is_empty() {",
    "expect_failing": [
      "fd_text_rules_and_bounds"
    ],
    "rule": "Descriptor input rejects embedded NUL instead of truncating or changing the encryption key."
  },
  {
    "id": "S-input-limit",
    "file": "crates/secrets/src/lib.rs",
    "find": "if raw.len() > MAX_PASSPHRASE_BYTES {",
    "replace": "if raw.len() > MAX_PASSPHRASE_BYTES + 1 {",
    "expect_failing": [
      "fd_text_rules_and_bounds"
    ],
    "rule": "The 8192-byte bound applies before trimming line endings."
  },
  {
    "id": "S-descriptor-close",
    "file": "crates/secrets/src/lib.rs",
    "find": "libc::close(self.0);",
    "replace": "libc::fcntl(self.0, libc::F_GETFD);",
    "expect_failing": [
      "descriptor_input_closes_and_bypasses_confirmation_in_machine_mode"
    ],
    "rule": "Reading a passphrase consumes and closes the caller's descriptor."
  },
  {
    "id": "S-new-key-characters",
    "file": "crates/secrets/src/service.rs",
    "find": "if secret.expose().chars().count() < 8 {",
    "replace": "if secret.expose().len() < 8 {",
    "expect_failing": [
      "new_passphrase_minimum_counts_characters_and_preserves_spaces"
    ],
    "rule": "The new-passphrase minimum counts Python characters, not UTF-8 bytes."
  },
  {
    "id": "S-empty-verification",
    "file": "crates/store/src/encryption.rs",
    "find": "apply_keying(&fresh, passphrase)?;\n    integrity(&fresh)?;",
    "replace": "apply_keying(&fresh, passphrase)?;",
    "expect_failing": [
      "corrupt_empty_candidate_never_replaces_the_live_placeholder"
    ],
    "rule": "Only a freshly verified encrypted candidate may replace the empty live placeholder."
  },
  {
    "id": "S-empty-file-is-not-encryption",
    "file": "crates/store/src/encryption.rs",
    "find": "if database.metadata().map_err(Error::io)?.len() == 0 {",
    "replace": "if database.metadata().map_err(Error::io)?.len() == u64::MAX {",
    "expect_failing": [
      "empty_verification_never_recreates_a_missing_or_zero_byte_candidate"
    ],
    "rule": "A zero-byte file is not evidence of an encrypted database, even when SQLite accepts integrity_check on it."
  },
  {
    "id": "S-rekey-auth-before-invalidation",
    "file": "crates/store/src/encryption.rs",
    "find": "let conn = open(&path, Some(current))?;\n    before_rekey()?;",
    "replace": "before_rekey()?;\n    let conn = open(&path, Some(current))?;",
    "expect_failing": [
      "native_guard_callback_runs_only_after_authentication_and_stays_armed_on_ambiguity"
    ],
    "rule": "A wrong current passphrase must not invalidate native credentials."
  },
  {
    "id": "S-rekey-new-key",
    "file": "crates/store/src/encryption.rs",
    "find": "let literal = quote_secret(new);",
    "replace": "let literal = quote_secret(current);",
    "expect_failing": [
      "encryption_and_rekey_preserve_identity_and_rollback_copy"
    ],
    "rule": "Rekey installs the new key and verifies a fresh connection while preserving the rollback copy and database identity."
  },
  {
    "id": "S-account-v2",
    "file": "crates/secrets/src/lib.rs",
    "find": "kassiber-cli-remembered-unlock-v2:",
    "replace": "kassiber-cli-remembered-unlock-v1:",
    "expect_failing": [
      "credential_account_matches_the_python_v2_digest"
    ],
    "rule": "Credential account identity exactly matches the Python database/enrollment-bound v2 digest."
  },
  {
    "id": "S-enroll-auth-order",
    "file": "crates/secrets/src/policy.rs",
    "find": "let admitted = namespace.canonical_project(root).map_err(storage_error)?;",
    "replace": "store.set_password(CLI_PASSPHRASE_SERVICE, \"unauthenticated\", secret).map_err(storage_error)?;\n    let admitted = namespace.canonical_project(root).map_err(storage_error)?;",
    "expect_failing": [
      "wrong_enrollment_key_never_writes_or_deletes_credentials"
    ],
    "rule": "Authenticate the database before touching any keyring item."
  },
  {
    "id": "S-forget-auth-order",
    "file": "crates/secrets/src/service.rs",
    "find": "            let book = kassiber_store::Book::open_migrating(\n                &paths.data_root,\n                kassiber_store::OpenOptions {\n                    passphrase: Some(secret.expose()),\n                    ..Default::default()\n                },\n                true,\n            )\n            .map_err(storage_error)?;\n            book.close()\n                .map_err(|failure| storage_error(failure.error))?;\n",
    "replace": "            drop(secret);\n",
    "expect_failing": [
      "forget_requires_fresh_authentication_before_any_native_or_policy_effect"
    ],
    "rule": "CLI revocation requires fresh database authentication before any native or policy effect."
  },
  {
    "id": "S-native-generation",
    "file": "crates/secrets/src/policy.rs",
    "find": "settings.insert(\"operator_native_auth_generation\".into(), json!(generation));",
    "replace": "settings.remove(\"operator_native_auth_generation\");",
    "expect_failing": [
      "rotation_authenticates_before_guards_and_refreshes_only_the_bound_item"
    ],
    "rule": "Successful rekey durably invalidates the independent operator credential generation."
  },
  {
    "id": "S-refresh-disable",
    "file": "crates/secrets/src/policy.rs",
    "find": "let cleared = policy.disable(quarantine).is_ok();",
    "replace": "let cleared = true;",
    "expect_failing": [
      "failed_rotation_refresh_disables_policy_and_keeps_the_successful_new_key"
    ],
    "rule": "A failed credential refresh disables remembered unlock and quarantines legacy copies."
  },
  {
    "id": "S-revoke-owned-legacy",
    "file": "crates/secrets/src/policy.rs",
    "find": "let owned = policy.enabled() || policy.quarantined();",
    "replace": "let owned = false;",
    "expect_failing": [
      "failed_legacy_cleanup_rolls_back_new_enrollment_and_quarantines_revocation"
    ],
    "rule": "Owned legacy credentials must be cleaned or quarantined during revocation."
  },
  {
    "id": "S-credential-duplicates",
    "file": "crates/secrets/src/credentials.rs",
    "find": "if !duplicates.is_empty() {",
    "replace": "if false {",
    "expect_failing": [
      "duplicate_credential_targets_fail_before_database_or_dotenv_changes"
    ],
    "rule": "Alias collisions refuse all database and dotenv changes."
  },
  {
    "id": "S-credential-row-commit",
    "file": "crates/secrets/src/credentials.rs",
    "find": "tx.commit().map_err(sql)?;",
    "replace": "tx.rollback().map_err(sql)?;",
    "expect_failing": [
      "every_credential_publication_boundary_retains_committed_values_and_is_repeatable"
    ],
    "rule": "The encrypted target must commit before the source dotenv can be sanitized."
  },
  {
    "id": "S-credential-field-selection",
    "file": "crates/secrets/src/credentials.rs",
    "find": "[\"auth_header\", \"password\", \"token\", \"username\"].contains(&field)",
    "replace": "[\"auth_header\", \"password\", \"token\", \"username\", \"cookiefile\"].contains(&field)",
    "expect_failing": [
      "dotenv_aliases_quotes_line_numbers_and_secret_free_scan_match_python"
    ],
    "rule": "Only the four Python credential fields move; cookiefile remains a path."
  },
  {
    "id": "S-credential-sanitize",
    "file": "crates/secrets/src/credentials.rs",
    "find": "drop_lines.insert(finding.lineno);",
    "replace": "drop_lines.insert(usize::MAX);",
    "expect_failing": [
      "credential_move_preserves_unknown_fields_and_skipped_dotenv_lines"
    ],
    "rule": "Sanitization removes only successfully migrated source lines while preserving skipped entries."
  },
  {
    "id": "S-touch-id-binding",
    "file": "crates/secrets/src/modes.rs",
    "find": "    require_project_policy_binding(namespace, &located.root)?;\n",
    "replace": "    let _ = require_project_policy_binding(namespace, &located.root);\n",
    "expect_failing": [
      "operator_touch_id_account_follows_the_binding_and_the_generation"
    ],
    "rule": "The operator Touch ID account exists only while the policy is bound to this file."
  },
  {
    "id": "S-touch-id-generation",
    "file": "crates/secrets/src/modes.rs",
    "find": "        None => \"initial\".to_owned(),\n",
    "replace": "        None => \"invalid\".to_owned(),\n",
    "expect_failing": [
      "operator_touch_id_account_follows_the_binding_and_the_generation"
    ],
    "rule": "An unset native-auth generation is Python's \"initial\", so existing enrollments keep their account."
  }
]
