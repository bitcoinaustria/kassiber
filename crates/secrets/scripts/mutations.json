[
  {
    "id": "S-input-nul",
    "file": "crates/secrets/src/lib.rs",
    "find": "if value.is_empty() || value.contains('\\0') {",
    "replace": "if value.is_empty() {",
    "expect_failing": ["fd_text_rules_and_bounds"],
    "rule": "Descriptor input rejects embedded NUL instead of truncating or changing the encryption key."
  },
  {
    "id": "S-input-limit",
    "file": "crates/secrets/src/lib.rs",
    "find": "if raw.len() > MAX_PASSPHRASE_BYTES {",
    "replace": "if raw.len() > MAX_PASSPHRASE_BYTES + 1 {",
    "expect_failing": ["fd_text_rules_and_bounds"],
    "rule": "The 8192-byte bound applies before trimming line endings."
  },
  {
    "id": "S-descriptor-close",
    "file": "crates/secrets/src/lib.rs",
    "find": "libc::close(self.0);",
    "replace": "libc::fcntl(self.0, libc::F_GETFD);",
    "expect_failing": ["descriptor_input_closes_and_bypasses_confirmation_in_machine_mode"],
    "rule": "Reading a passphrase consumes and closes the caller's descriptor."
  },
  {
    "id": "S-new-key-characters",
    "file": "crates/secrets/src/service.rs",
    "find": "if secret.expose().chars().count() < 8 {",
    "replace": "if secret.expose().len() < 8 {",
    "expect_failing": ["new_passphrase_minimum_counts_characters_and_preserves_spaces"],
    "rule": "The new-passphrase minimum counts Python characters, not UTF-8 bytes."
  },
  {
    "id": "S-empty-verification",
    "file": "crates/store/src/encryption.rs",
    "find": "apply_keying(&fresh, passphrase)?;\n    integrity(&fresh)?;",
    "replace": "apply_keying(&fresh, passphrase)?;",
    "expect_failing": ["corrupt_empty_candidate_never_replaces_the_live_placeholder"],
    "rule": "Only a freshly verified encrypted candidate may replace the empty live placeholder."
  },
  {
    "id": "S-empty-file-is-not-encryption",
    "file": "crates/store/src/encryption.rs",
    "find": "if database.metadata().map_err(Error::io)?.len() == 0 {",
    "replace": "if database.metadata().map_err(Error::io)?.len() == u64::MAX {",
    "expect_failing": ["empty_verification_never_recreates_a_missing_or_zero_byte_candidate"],
    "rule": "A zero-byte file is not evidence of an encrypted database, even when SQLite accepts integrity_check on it."
  },
  {
    "id": "S-rekey-auth-before-invalidation",
    "file": "crates/store/src/encryption.rs",
    "find": "let conn = open(&path, Some(current))?;\n    before_rekey()?;",
    "replace": "before_rekey()?;\n    let conn = open(&path, Some(current))?;",
    "expect_failing": ["native_guard_callback_runs_only_after_authentication_and_stays_armed_on_ambiguity"],
    "rule": "A wrong current passphrase must not invalidate native credentials."
  },
  {
    "id": "S-rekey-new-key",
    "file": "crates/store/src/encryption.rs",
    "find": "let literal = quote_secret(new);",
    "replace": "let literal = quote_secret(current);",
    "expect_failing": ["encryption_and_rekey_preserve_identity_and_rollback_copy"],
    "rule": "Rekey installs the new key and verifies a fresh connection while preserving the rollback copy and database identity."
  }
]
